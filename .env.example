# Environment variables read by the CLI / OllamaClient.from_env().
# They are read from the process environment: this version does not auto-load a .env file.
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:8b
# Seconds. The read timeout covers model loading + generation on the first call.
OLLAMA_CONNECT_TIMEOUT=5
OLLAMA_READ_TIMEOUT=300
LOG_LEVEL=INFO
